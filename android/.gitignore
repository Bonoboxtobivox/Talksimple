/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your RELEASE keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks

# debug.keystore is the exception: it's the app's DEBUG signing key, used
# only for sideloaded test builds (see CLAUDE.md / CI workflow), not for
# the Play Store. It's committed on purpose so every CI build is signed
# with the same key and can be installed over the previous one instead of
# needing an uninstall each time. Its password is the well-known Android
# default ("android") - there is nothing secret about it.
!debug.keystore
